  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var auth = pm.request.auth;",
          "if (auth && auth.type === 'bearer') {",
          "  var tokenEntry = auth.bearer && auth.bearer.find(function (item) { return item.key === 'token'; });",
          "  if (tokenEntry) {",
          "    var token = pm.variables.replaceIn(tokenEntry.value || '');",
          "    if (!token || token.indexOf('{{') !== -1) {",
          "      throw new Error('Missing bearer token for request: ' + pm.info.requestName);",
          "    }",
          "  }",
          "}"
        ]
      }
    }
