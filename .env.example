# Mailjet Configuration
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAILJET_SENDER_EMAIL=your-sender-email@yourdomain.com
MAILJET_SENDER_NAME=Hotel Management System

# Cloudinary Configuration
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Password Reset URL (Frontend)
PASSWORD_RESET_BASE_URL=http://localhost:5173/auth/reset-password

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,X-Total-Count
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
