# Hotel Management System - Production Docker Environment
# Copy this file and update with your production values
# Usage: docker-compose --env-file docker.env up

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-key-change-this

# Mailjet Email Service Configuration
MAILJET_API_KEY=your-production-mailjet-api-key
MAILJET_SECRET_KEY=your-production-mailjet-secret-key
MAILJET_SENDER_EMAIL=noreply@yourdomain.com
MAILJET_SENDER_NAME=Hotel Management System

# Cloudinary Image Management Configuration
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Application Configuration
PASSWORD_RESET_BASE_URL=https://yourdomain.com/auth/reset-password

# CORS Configuration - Set to your production domains
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,X-Total-Count
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Optional: Override default values
# APP_PASSWORD_RESET_EXPIRATION_MINUTES=30
# SPRING_JPA_SHOW_SQL=false
# SPRING_H2_CONSOLE_ENABLED=false
